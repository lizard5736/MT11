<Window x:Class="Grip.UI.CommandBar.CommandBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Grip.UI.Controls"
        xmlns:l="clr-namespace:Grip.UI"
        xmlns:local="clr-namespace:Grip.UI.CommandBar"
        Style="{StaticResource Grip.Window}"
        Title="Command Bar" Width="660" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:CommandRow}">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Border CornerRadius="8" Background="{DynamicResource Grip.Control}"
                            Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                        <c:Icon Kind="{Binding Icon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{DynamicResource Grip.TextSecondary}" />
                    </Border>
                    <Image Source="{Binding Image}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Glyph}" FontSize="22" FontFamily="Segoe UI Emoji" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasGlyph, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Grip.Text.Body}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Grip.Text.Caption}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" Visibility="{Binding Subtitle, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <c:Icon Grid.Column="2" Kind="ArrowEnterLeft" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource Grip.TextTertiary}"
                        Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="HeaderTemplate" DataType="{x:Type local:CommandRow}">
            <TextBlock Text="{Binding Title, Converter={x:Static l:UpperConverter.Instance}}" Style="{StaticResource Grip.Text.Section}"
                       Margin="2,10,0,4" />
        </DataTemplate>
        <local:RowTemplateSelector x:Key="RowSelector" Result="{StaticResource ResultTemplate}" Header="{StaticResource HeaderTemplate}" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Grip.Line}" BorderThickness="1">
        <StackPanel>
            <DockPanel Margin="18,14,16,12">
                <c:Icon DockPanel.Dock="Left" Kind="WindowConsole" Size="22" Foreground="{DynamicResource Grip.Accent}" Margin="0,0,8,0" />
                <TextBox x:Name="QueryBox" Style="{StaticResource Grip.SearchBox}" FontSize="19" l:TextBoxHelper.Icon="{x:Null}"
                         l:TextBoxHelper.Placeholder="{l:T commandBar.placeholder}" TextChanged="OnQuery" />
            </DockPanel>
            <Border x:Name="ResultsHost" Style="{StaticResource Grip.Divider}" Visibility="Collapsed" />
            <TextBlock x:Name="LayoutHint" Style="{StaticResource Grip.Text.Caption}" Margin="20,8,20,0" Visibility="Collapsed" />
            <ListBox x:Name="Results" Style="{StaticResource Grip.List}" Margin="10,4,10,8" MaxHeight="440"
                     ItemTemplateSelector="{StaticResource RowSelector}" Visibility="Collapsed"
                     MouseUp="OnResultClick" PreviewMouseDown="OnResultMouseDown" />
            <Border x:Name="Footer" Background="{DynamicResource Grip.BgAlt}" BorderBrush="{DynamicResource Grip.Line}" BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <TextBlock Text="{l:T commandBar.hint}" Style="{StaticResource Grip.Text.Caption}" Margin="18,7,18,7" />
            </Border>
        </StackPanel>
    </Border>
</Window>
