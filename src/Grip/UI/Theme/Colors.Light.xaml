<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Grip «Светлая» palette. Brushes are frozen and swapped as a whole dictionary. -->
    <Color x:Key="Grip.Color.Bg">#F5F4F1</Color>
    <Color x:Key="Grip.Color.BgAlt">#EDEBE7</Color>
    <Color x:Key="Grip.Color.Surface">#FFFFFF</Color>
    <Color x:Key="Grip.Color.SurfaceHover">#FAF9F7</Color>
    <Color x:Key="Grip.Color.SurfacePressed">#F1EFEB</Color>
    <Color x:Key="Grip.Color.Control">#EDEBE7</Color>
    <Color x:Key="Grip.Color.ControlHover">#E5E2DD</Color>
    <Color x:Key="Grip.Color.ControlPressed">#DDD9D3</Color>
    <Color x:Key="Grip.Color.ControlDisabled">#F0EEEA</Color>
    <Color x:Key="Grip.Color.Line">#E4E1DC</Color>
    <Color x:Key="Grip.Color.LineStrong">#CFCBC4</Color>
    <Color x:Key="Grip.Color.Text">#171717</Color>
    <Color x:Key="Grip.Color.TextSecondary">#5B5B5B</Color>
    <Color x:Key="Grip.Color.TextTertiary">#8C8C8C</Color>
    <Color x:Key="Grip.Color.TextDisabled">#B5B5B5</Color>
    <Color x:Key="Grip.Color.Accent">#FFB020</Color>
    <Color x:Key="Grip.Color.AccentHover">#FFBE3F</Color>
    <Color x:Key="Grip.Color.AccentPressed">#F0A000</Color>
    <Color x:Key="Grip.Color.AccentSubtle">#33FFB020</Color>
    <Color x:Key="Grip.Color.AccentSubtleHover">#4DFFB020</Color>
    <Color x:Key="Grip.Color.AccentText">#8F5C00</Color>
    <Color x:Key="Grip.Color.OnAccent">#171717</Color>
    <Color x:Key="Grip.Color.Rec">#E0352B</Color>
    <Color x:Key="Grip.Color.RecSubtle">#1FE0352B</Color>
    <Color x:Key="Grip.Color.Success">#1E9E5A</Color>
    <Color x:Key="Grip.Color.SuccessSubtle">#1F1E9E5A</Color>
    <Color x:Key="Grip.Color.Scrim">#66000000</Color>
    <Color x:Key="Grip.Color.Selection">#66FFB020</Color>
    <Color x:Key="Grip.Color.ToggleOffTrack">#E5E2DD</Color>
    <Color x:Key="Grip.Color.ToggleOffBorder">#A8A39B</Color>
    <Color x:Key="Grip.Color.ToggleOffThumb">#5B5B5B</Color>
    <Color x:Key="Grip.Color.Tooltip">#FFFFFF</Color>
    <Color x:Key="Grip.Color.Popup">#FFFFFF</Color>
    <Color x:Key="Grip.Color.KeyCapFill">#FFFFFF</Color>
    <Color x:Key="Grip.Color.KeyCapBorder">#CFCBC4</Color>
    <Color x:Key="Grip.Color.Shadow">#40000000</Color>
    <SolidColorBrush x:Key="Grip.Bg" Color="{StaticResource Grip.Color.Bg}" />
    <SolidColorBrush x:Key="Grip.BgAlt" Color="{StaticResource Grip.Color.BgAlt}" />
    <SolidColorBrush x:Key="Grip.Surface" Color="{StaticResource Grip.Color.Surface}" />
    <SolidColorBrush x:Key="Grip.SurfaceHover" Color="{StaticResource Grip.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Grip.SurfacePressed" Color="{StaticResource Grip.Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Grip.Control" Color="{StaticResource Grip.Color.Control}" />
    <SolidColorBrush x:Key="Grip.ControlHover" Color="{StaticResource Grip.Color.ControlHover}" />
    <SolidColorBrush x:Key="Grip.ControlPressed" Color="{StaticResource Grip.Color.ControlPressed}" />
    <SolidColorBrush x:Key="Grip.ControlDisabled" Color="{StaticResource Grip.Color.ControlDisabled}" />
    <SolidColorBrush x:Key="Grip.Line" Color="{StaticResource Grip.Color.Line}" />
    <SolidColorBrush x:Key="Grip.LineStrong" Color="{StaticResource Grip.Color.LineStrong}" />
    <SolidColorBrush x:Key="Grip.Text" Color="{StaticResource Grip.Color.Text}" />
    <SolidColorBrush x:Key="Grip.TextSecondary" Color="{StaticResource Grip.Color.TextSecondary}" />
    <SolidColorBrush x:Key="Grip.TextTertiary" Color="{StaticResource Grip.Color.TextTertiary}" />
    <SolidColorBrush x:Key="Grip.TextDisabled" Color="{StaticResource Grip.Color.TextDisabled}" />
    <SolidColorBrush x:Key="Grip.Accent" Color="{StaticResource Grip.Color.Accent}" />
    <SolidColorBrush x:Key="Grip.AccentHover" Color="{StaticResource Grip.Color.AccentHover}" />
    <SolidColorBrush x:Key="Grip.AccentPressed" Color="{StaticResource Grip.Color.AccentPressed}" />
    <SolidColorBrush x:Key="Grip.AccentSubtle" Color="{StaticResource Grip.Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Grip.AccentSubtleHover" Color="{StaticResource Grip.Color.AccentSubtleHover}" />
    <SolidColorBrush x:Key="Grip.AccentText" Color="{StaticResource Grip.Color.AccentText}" />
    <SolidColorBrush x:Key="Grip.OnAccent" Color="{StaticResource Grip.Color.OnAccent}" />
    <SolidColorBrush x:Key="Grip.Rec" Color="{StaticResource Grip.Color.Rec}" />
    <SolidColorBrush x:Key="Grip.RecSubtle" Color="{StaticResource Grip.Color.RecSubtle}" />
    <SolidColorBrush x:Key="Grip.Success" Color="{StaticResource Grip.Color.Success}" />
    <SolidColorBrush x:Key="Grip.SuccessSubtle" Color="{StaticResource Grip.Color.SuccessSubtle}" />
    <SolidColorBrush x:Key="Grip.Scrim" Color="{StaticResource Grip.Color.Scrim}" />
    <SolidColorBrush x:Key="Grip.Selection" Color="{StaticResource Grip.Color.Selection}" />
    <SolidColorBrush x:Key="Grip.ToggleOffTrack" Color="{StaticResource Grip.Color.ToggleOffTrack}" />
    <SolidColorBrush x:Key="Grip.ToggleOffBorder" Color="{StaticResource Grip.Color.ToggleOffBorder}" />
    <SolidColorBrush x:Key="Grip.ToggleOffThumb" Color="{StaticResource Grip.Color.ToggleOffThumb}" />
    <SolidColorBrush x:Key="Grip.Tooltip" Color="{StaticResource Grip.Color.Tooltip}" />
    <SolidColorBrush x:Key="Grip.Popup" Color="{StaticResource Grip.Color.Popup}" />
    <SolidColorBrush x:Key="Grip.KeyCapFill" Color="{StaticResource Grip.Color.KeyCapFill}" />
    <SolidColorBrush x:Key="Grip.KeyCapBorder" Color="{StaticResource Grip.Color.KeyCapBorder}" />
    <SolidColorBrush x:Key="Grip.Shadow" Color="{StaticResource Grip.Color.Shadow}" />
</ResourceDictionary>
