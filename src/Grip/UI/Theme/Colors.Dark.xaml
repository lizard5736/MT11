<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Grip «Графит» palette. Brushes are frozen and swapped as a whole dictionary. -->
    <Color x:Key="Grip.Color.Bg">#141414</Color>
    <Color x:Key="Grip.Color.BgAlt">#101010</Color>
    <Color x:Key="Grip.Color.Surface">#1E1E1E</Color>
    <Color x:Key="Grip.Color.SurfaceHover">#252525</Color>
    <Color x:Key="Grip.Color.SurfacePressed">#1A1A1A</Color>
    <Color x:Key="Grip.Color.Control">#262626</Color>
    <Color x:Key="Grip.Color.ControlHover">#2F2F2F</Color>
    <Color x:Key="Grip.Color.ControlPressed">#222222</Color>
    <Color x:Key="Grip.Color.ControlDisabled">#1C1C1C</Color>
    <Color x:Key="Grip.Color.Line">#2A2A2A</Color>
    <Color x:Key="Grip.Color.LineStrong">#3A3A3A</Color>
    <Color x:Key="Grip.Color.Text">#F2F2F2</Color>
    <Color x:Key="Grip.Color.TextSecondary">#A3A3A3</Color>
    <Color x:Key="Grip.Color.TextTertiary">#6E6E6E</Color>
    <Color x:Key="Grip.Color.TextDisabled">#4E4E4E</Color>
    <Color x:Key="Grip.Color.Accent">#FFB020</Color>
    <Color x:Key="Grip.Color.AccentHover">#FFC04A</Color>
    <Color x:Key="Grip.Color.AccentPressed">#E59A0F</Color>
    <Color x:Key="Grip.Color.AccentSubtle">#26FFB020</Color>
    <Color x:Key="Grip.Color.AccentSubtleHover">#38FFB020</Color>
    <Color x:Key="Grip.Color.AccentText">#FFB020</Color>
    <Color x:Key="Grip.Color.OnAccent">#141414</Color>
    <Color x:Key="Grip.Color.Rec">#FF453A</Color>
    <Color x:Key="Grip.Color.RecSubtle">#26FF453A</Color>
    <Color x:Key="Grip.Color.Success">#3DD68C</Color>
    <Color x:Key="Grip.Color.SuccessSubtle">#243DD68C</Color>
    <Color x:Key="Grip.Color.Scrim">#99000000</Color>
    <Color x:Key="Grip.Color.Selection">#66FFB020</Color>
    <Color x:Key="Grip.Color.ToggleOffTrack">#2B2B2B</Color>
    <Color x:Key="Grip.Color.ToggleOffBorder">#4A4A4A</Color>
    <Color x:Key="Grip.Color.ToggleOffThumb">#A3A3A3</Color>
    <Color x:Key="Grip.Color.Tooltip">#262626</Color>
    <Color x:Key="Grip.Color.Popup">#1B1B1B</Color>
    <Color x:Key="Grip.Color.KeyCapFill">#262626</Color>
    <Color x:Key="Grip.Color.KeyCapBorder">#3A3A3A</Color>
    <Color x:Key="Grip.Color.Shadow">#000000</Color>
    <SolidColorBrush x:Key="Grip.Bg" Color="{StaticResource Grip.Color.Bg}" />
    <SolidColorBrush x:Key="Grip.BgAlt" Color="{StaticResource Grip.Color.BgAlt}" />
    <SolidColorBrush x:Key="Grip.Surface" Color="{StaticResource Grip.Color.Surface}" />
    <SolidColorBrush x:Key="Grip.SurfaceHover" Color="{StaticResource Grip.Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Grip.SurfacePressed" Color="{StaticResource Grip.Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Grip.Control" Color="{StaticResource Grip.Color.Control}" />
    <SolidColorBrush x:Key="Grip.ControlHover" Color="{StaticResource Grip.Color.ControlHover}" />
    <SolidColorBrush x:Key="Grip.ControlPressed" Color="{StaticResource Grip.Color.ControlPressed}" />
    <SolidColorBrush x:Key="Grip.ControlDisabled" Color="{StaticResource Grip.Color.ControlDisabled}" />
    <SolidColorBrush x:Key="Grip.Line" Color="{StaticResource Grip.Color.Line}" />
    <SolidColorBrush x:Key="Grip.LineStrong" Color="{StaticResource Grip.Color.LineStrong}" />
    <SolidColorBrush x:Key="Grip.Text" Color="{StaticResource Grip.Color.Text}" />
    <SolidColorBrush x:Key="Grip.TextSecondary" Color="{StaticResource Grip.Color.TextSecondary}" />
    <SolidColorBrush x:Key="Grip.TextTertiary" Color="{StaticResource Grip.Color.TextTertiary}" />
    <SolidColorBrush x:Key="Grip.TextDisabled" Color="{StaticResource Grip.Color.TextDisabled}" />
    <SolidColorBrush x:Key="Grip.Accent" Color="{StaticResource Grip.Color.Accent}" />
    <SolidColorBrush x:Key="Grip.AccentHover" Color="{StaticResource Grip.Color.AccentHover}" />
    <SolidColorBrush x:Key="Grip.AccentPressed" Color="{StaticResource Grip.Color.AccentPressed}" />
    <SolidColorBrush x:Key="Grip.AccentSubtle" Color="{StaticResource Grip.Color.AccentSubtle}" />
