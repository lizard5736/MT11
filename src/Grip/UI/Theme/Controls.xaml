<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Grip.UI.Controls"
                    xmlns:ui="clr-namespace:Grip.UI">

    <!-- ============ Type ============ -->
    <!-- Grip.Font/.Mono: one face everywhere, on purpose — body text stays legible and
         doesn't change look with the theme. Grip.Font.Display is the exception: it lives in
         each Colors.*.xaml palette instead of here, because DOOM swaps it for a display face
         of its own (see Grip.Text.Title/.Hero below, which read it as a DynamicResource so
         that swap actually takes effect without a restart). -->
    <FontFamily x:Key="Grip.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Grip.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <ui:BoolToVisibilityConverter x:Key="BoolToVis" />
    <ui:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
    <ui:InvertBoolConverter x:Key="InvertBool" />
    <ui:HexToBrushConverter x:Key="HexToBrush" />

    <Style x:Key="Grip.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="Grip.Text.Strong" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Grip.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Grip.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Grip.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextTertiary}" />
    </Style>
    <Style x:Key="Grip.Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Grip.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource Grip.Font.Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Grip.Text.Hero" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontFamily" Value="{DynamicResource Grip.Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Grip.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Grip.Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A window's base look: graphite background, Grip type. -->
    <Style x:Key="Grip.Window" TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Grip.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============ Focus ============ -->
    <Style x:Key="Grip.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="8" BorderBrush="{DynamicResource Grip.Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Surfaces ============ -->
    <Style x:Key="Grip.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Grip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="Grip.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Grip.Line}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Grip.KeyCap" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Grip.KeyCapFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.KeyCapBorder}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1,6,1" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="Grip.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- ============ Buttons ============ -->
    <ControlTemplate x:Key="Grip.ButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding ui:Ui.CornerRadius}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <c:Icon x:Name="Glyph" Kind="{TemplateBinding ui:Ui.Icon}" Size="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ContentPresenter x:Name="Content" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Glyph" Property="Margin" Value="0" />
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Grip.Button" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ui:Ui.CornerRadius" Value="6" />
        <Setter Property="Template" Value="{StaticResource Grip.ButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.ControlHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.ControlPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grip.Button.Accent" TargetType="ButtonBase" BasedOn="{StaticResource Grip.Button}">
        <Setter Property="Background" Value="{DynamicResource Grip.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.AccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Grip.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.AccentPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Grip.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grip.Button.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource Grip.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextSecondary}" />
        <Setter Property="Padding" Value="10,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.ControlPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grip.Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Grip.Button.Ghost}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ui:Ui.CornerRadius" Value="6" />
    </Style>

    <Style x:Key="Grip.Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Grip.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Grip.Rec}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.RecSubtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grip.Button.Link" TargetType="ButtonBase" BasedOn="{StaticResource Grip.Button.Ghost}">
        <Setter Property="Foreground" Value="{DynamicResource Grip.AccentText}" />
        <Setter Property="Padding" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.AccentHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A full-width, left-aligned row button (utility tiles, list actions). -->
    <Style x:Key="Grip.Button.Row" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Grip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Grip.LineStrong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.SurfacePressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A quiet row inside a card: no chrome until hovered. -->
    <Style x:Key="Grip.Button.ListRow" TargetType="ButtonBase" BasedOn="{StaticResource Grip.Button.Row}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,7" />
        <Setter Property="Margin" Value="0,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.SurfaceHover}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Toggle switch ============ -->
    <Style x:Key="Grip.Toggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.14">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" Duration="0" To="22,0,0,0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Track" CornerRadius="11" BorderThickness="1"
                                Background="{DynamicResource Grip.ToggleOffTrack}" BorderBrush="{DynamicResource Grip.ToggleOffBorder}" />
                        <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0"
                                 Fill="{DynamicResource Grip.ToggleOffThumb}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Grip.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Grip.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Grip.OnAccent}" />
                            <!-- The resting position; the visual state above only animates towards it. -->
                            <Setter TargetName="Thumb" Property="Margin" Value="22,0,0,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Grip.TextTertiary}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Grip.AccentHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Checkbox (Markdown task lists) ============ -->
    <Style x:Key="Grip.CheckBox" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.4"
                            Background="{DynamicResource Grip.Control}" BorderBrush="{DynamicResource Grip.LineStrong}">
                        <Path x:Name="Check" Data="{StaticResource Icon.Checkmark}" Stretch="Uniform" Margin="3"
                              Fill="{DynamicResource Grip.OnAccent}" Visibility="Collapsed" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Grip.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Grip.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Grip.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Chips, tabs, navigation ============ -->
    <Style x:Key="Grip.Chip" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon x:Name="Glyph" Kind="{TemplateBinding ui:Ui.Icon}" Size="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.ControlHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.AccentSubtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Grip.AccentSubtleHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grip.Tab" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" />
                        <c:Icon Kind="{TemplateBinding ui:Ui.Icon}" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border x:Name="Underline" Height="2" Width="16" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                Background="{DynamicResource Grip.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.AccentSubtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Grip.NavItem" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" />
                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,0,0,0"
                                Background="{DynamicResource Grip.Accent}" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Margin="12,0,10,0" VerticalAlignment="Center">
                            <c:Icon Kind="{TemplateBinding ui:Ui.Icon}" Size="16" Margin="0,0,11,0" />
                            <ContentPresenter VerticalAlignment="Center" TextBlock.FontSize="13" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.Surface}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Text input ============ -->
    <Style x:Key="Grip.TextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Grip.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Grip.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Grip.Selection}" />
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" SnapsToDevicePixels="True">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Icon x:Name="Glyph" Kind="{TemplateBinding ui:TextBoxHelper.Icon}" Size="16" Margin="2,0,8,0"
                                    Foreground="{DynamicResource Grip.TextTertiary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding ui:TextBoxHelper.Placeholder}"
                                       Foreground="{DynamicResource Grip.TextTertiary}" FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="2,0,0,0"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource Grip.Button.Icon}" Width="22" Height="22"
                                    ui:Ui.Icon="Dismiss" ui:Ui.CornerRadius="11" Margin="6,0,0,0" Visibility="Collapsed"
                                    Focusable="False" Command="{x:Static ui:TextBoxHelper.ClearCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:TextBoxHelper.Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ui:TextBoxHelper.ClearButton" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Grip.LineStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Grip.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A borderless, large search field for pop-up tools. -->
    <Style x:Key="Grip.SearchBox" TargetType="TextBox" BasedOn="{StaticResource Grip.TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="ui:TextBoxHelper.Icon" Value="Search" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ ComboBox ============ -->
    <Style x:Key="Grip.ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{DynamicResource Grip.Control}" BorderBrush="{DynamicResource Grip.Line}"
                            BorderThickness="1" CornerRadius="7">
                        <c:Icon Kind="ChevronDown" Size="14" HorizontalAlignment="Right" Margin="0,0,10,0"
                                Foreground="{DynamicResource Grip.TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Grip.ControlHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Grip.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Grip.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Grip.Control}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Grip.AccentSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Grip.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Grip.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Grip.ComboBoxItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Grip.ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="11,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Grip.Popup}" BorderBrush="{DynamicResource Grip.LineStrong}" BorderThickness="1"
                                    CornerRadius="8" Padding="0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="6">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="{DynamicResource Grip.Color.Shadow}" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Lists ============ -->
    <Style x:Key="Grip.ListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,8"
                                Background="{DynamicResource Grip.Accent}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Grip.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Grip.AccentSubtle}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Grip.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Grip.ListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- ============ Scrollbars (implicit, thin) ============ -->
    <Style x:Key="Grip.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Pill" CornerRadius="3" Background="{DynamicResource Grip.TextTertiary}" Opacity="0.45" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource Grip.ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Grip.ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Tooltips and menus (implicit) ============ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Grip.Tooltip}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.LineStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" MaxWidth="320">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Grip.Popup}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Grip.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Grip.LineStrong}" BorderThickness="1"
                            CornerRadius="8" Padding="4" MinWidth="200">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Icon Kind="{TemplateBinding ui:Ui.Icon}" Size="16" HorizontalAlignment="Left" />
                            <c:Icon x:Name="Check" Kind="Checkmark" Size="16" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Foreground="{DynamicResource Grip.AccentText}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0"
                                       Foreground="{DynamicResource Grip.TextTertiary}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Grip.Control}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Grip.Line}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Quick toggle tiles ============ -->
    <Style x:Key="Grip.ToggleTile" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Grip.FocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource Grip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grip.Line}" />
        <Setter Property="Foreground" Value="{DynamicResource Grip.TextSecondary}" />
        <Setter Property="Height" Value="74" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="6,11,6,6">
                        <!-- Top-aligned so icons line up across a row whether the label takes one line or two. -->
                        <StackPanel VerticalAlignment="Top">
                            <c:Icon Kind="{TemplateBinding ui:Ui.Icon}" Size="20" HorizontalAlignment="Center" Margin="0,0,0,5" />
                            <!-- Applies only to the TextBlock generated for string content. -->
                            <ContentPresenter HorizontalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="TextAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="LineHeight" Value="15" />
                                        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.SurfaceHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Grip.LineStrong}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grip.AccentSubtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Grip.AccentSubtleHover}" />
                <Setter Property="Foreground" Value="{DynamicResource Grip.AccentText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Spacing tokens the compact panel overrides. -->
    <Thickness x:Key="Grip.Space.Card">14</Thickness>
    <Thickness x:Key="Grip.Space.Section">0,0,0,16</Thickness>

</ResourceDictionary>
