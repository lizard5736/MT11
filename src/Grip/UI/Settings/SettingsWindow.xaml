<Window x:Class="Grip.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Grip.UI.Controls"
        xmlns:l="clr-namespace:Grip.UI"
        Style="{StaticResource Grip.Window}"
        Title="{l:T settings.title}" Width="1000" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Grip;component/Assets/grip.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource Grip.BgAlt}" BorderBrush="{DynamicResource Grip.Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,14,14,12">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,16">
                    <c:GripMark Width="30" Height="30" TileBrush="{DynamicResource Grip.Surface}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Grip" Style="{StaticResource Grip.Text.Subtitle}" />
                        <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Grip.Text.Caption}" />
                    </StackPanel>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource Grip.TextBox}" Margin="0,0,0,12"
                         l:TextBoxHelper.Placeholder="{l:T settings.search}" l:TextBoxHelper.Icon="Search" l:TextBoxHelper.ClearButton="True"
                         TextChanged="OnSearch" />
                <ToggleButton x:Name="AboutNav" DockPanel.Dock="Bottom" Style="{StaticResource Grip.NavItem}" l:Ui.Icon="Info"
                              Content="{l:T settings.page.about}" Click="OnNavClick" Tag="about" Margin="0,8,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel x:Name="Nav" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Page -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel x:Name="PageHost" Margin="36,28,36,40" MaxWidth="780" HorizontalAlignment="Left">
                <TextBlock x:Name="PageTitle" Style="{StaticResource Grip.Text.Title}" />
                <TextBlock x:Name="PageDescription" Style="{StaticResource Grip.Text.Secondary}" FontSize="13" Margin="0,6,0,22" />
                <ContentControl x:Name="PageContent" Focusable="False" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
