<UserControl x:Class="Grip.UI.Clipboard.ClipRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Grip.UI.Controls"
             xmlns:local="clr-namespace:Grip.UI.Clipboard"
             d:DataContext="{d:DesignInstance local:ClipItem}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Leading visual: thumbnail, color swatch or kind icon -->
        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Grip.Control}" VerticalAlignment="Top" ClipToBounds="True">
            <Grid>
                <c:Icon Kind="{Binding KindIcon}" Size="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Foreground="{DynamicResource Grip.TextSecondary}"
                        Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" />
                <Border CornerRadius="8" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <Border Margin="7" CornerRadius="5" BorderBrush="{DynamicResource Grip.LineStrong}" BorderThickness="1"
                        Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                        Visibility="{Binding HasColor, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Grip.Text.Body}" TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap" MaxHeight="36" LineHeight="17" LineStackingStrategy="BlockLineHeight" />
            <TextBlock Text="{Binding Meta}" Style="{StaticResource Grip.Text.Caption}" TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <c:Icon Kind="PinFilled" Size="14" Margin="0,0,6,0" Foreground="{DynamicResource Grip.Accent}"
                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
            <Border x:Name="ShortcutCap" Style="{StaticResource Grip.KeyCap}" Margin="0"
                    Visibility="{Binding Shortcut, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Shortcut}" FontSize="10" Foreground="{DynamicResource Grip.TextTertiary}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
