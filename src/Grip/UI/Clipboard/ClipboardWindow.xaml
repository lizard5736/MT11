<Window x:Class="Grip.UI.Clipboard.ClipboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Grip.UI.Controls"
        xmlns:l="clr-namespace:Grip.UI"
        xmlns:local="clr-namespace:Grip.UI.Clipboard"
        Style="{StaticResource Grip.Window}"
        Title="{l:T clipboard.title}" Width="760" Height="500"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Grip.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Search -->
            <DockPanel Margin="16,14,14,6">
                <c:Icon DockPanel.Dock="Left" Kind="Clipboard" Size="20" Foreground="{DynamicResource Grip.Accent}" Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Style="{StaticResource Grip.SearchBox}" l:TextBoxHelper.Icon="{x:Null}"
                         l:TextBoxHelper.Placeholder="{l:T clipboard.search}" TextChanged="OnSearch" />
            </DockPanel>

            <!-- Filters -->
            <WrapPanel x:Name="Filters" Grid.Row="1" Margin="16,2,16,6" />

            <Border Grid.Row="2" Style="{StaticResource Grip.Divider}" VerticalAlignment="Top" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="300" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="List" Style="{StaticResource Grip.List}" Margin="8,8,4,8" MouseDoubleClick="OnDoubleClick"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ClipItem}">
                            <local:ClipRow />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Grip.Text.Secondary}" FontSize="13" Margin="24,20,24,0"
                           Visibility="Collapsed" />

                <!-- Preview -->
                <Border x:Name="PreviewPane" Grid.Column="1" Background="{DynamicResource Grip.BgAlt}" BorderBrush="{DynamicResource Grip.Line}"
                        BorderThickness="1,0,0,0">
                    <DockPanel Margin="16,14,16,14">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PinButton" Style="{StaticResource Grip.Button}" l:Ui.Icon="Pin" Click="OnPin" Padding="10,6" />
                            <Button Style="{StaticResource Grip.Button}" l:Ui.Icon="Delete" Content="{l:T clipboard.delete}" Click="OnDelete"
                                    Margin="8,0,0,0" Padding="10,6" />
                        </StackPanel>
                        <TextBlock x:Name="PreviewMeta" DockPanel.Dock="Bottom" Style="{StaticResource Grip.Text.Caption}" Margin="0,10,0,0" />
                        <Grid>
                            <ScrollViewer x:Name="PreviewTextHost" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="PreviewText" Style="{StaticResource Grip.Text.Body}" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <Border x:Name="PreviewImageHost" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top" Visibility="Collapsed">
                                <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" />
                            </Border>
                            <Border x:Name="PreviewSwatch" Height="64" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,0,0"
                                    BorderBrush="{DynamicResource Grip.LineStrong}" BorderThickness="1" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Hints -->
            <Border Grid.Row="3" Background="{DynamicResource Grip.BgAlt}" BorderBrush="{DynamicResource Grip.Line}" BorderThickness="0,1,0,0">
                <DockPanel Margin="16,8,16,8">
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Grip.Text.Caption}" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T clipboard.hint}" Style="{StaticResource Grip.Text.Caption}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
