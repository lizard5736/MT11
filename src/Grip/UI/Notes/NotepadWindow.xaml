<Window x:Class="Grip.UI.Notes.NotepadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Grip.UI.Controls"
        xmlns:l="clr-namespace:Grip.UI"
        Style="{StaticResource Grip.Window}"
        Title="{l:T scratchpad.title}" Width="420" Height="480" MinWidth="300" MinHeight="240"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="Frame" BorderBrush="{DynamicResource Grip.Line}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="FrameShift" />
        </Border.RenderTransform>
        <DockPanel>
            <!-- Title bar (drag to move) -->
            <DockPanel x:Name="TitleBar" DockPanel.Dock="Top" Margin="14,10,8,6" Background="Transparent" MouseLeftButtonDown="OnDragWindow">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource Grip.Tab}" l:Ui.Icon="Eye" ToolTip="{l:T scratchpad.preview}"
                                  Click="OnTogglePreview" Width="28" Height="28" />
                    <Button Style="{StaticResource Grip.Button.Icon}" l:Ui.Icon="ArrowUpload" ToolTip="{l:T scratchpad.export}" Click="OnExportNote" Width="28" Height="28" Margin="4,0,0,0" />
                    <Button Style="{StaticResource Grip.Button.Icon}" l:Ui.Icon="Add" ToolTip="{l:T scratchpad.new}" Click="OnNewNote" Width="28" Height="28" Margin="4,0,0,0" />
                    <Button Style="{StaticResource Grip.Button.Icon}" l:Ui.Icon="Dismiss" ToolTip="{l:T common.close}" Click="OnClose" Width="28" Height="28" Margin="4,0,0,0" />
                </StackPanel>
                <c:Icon Kind="Edit" Size="18" Foreground="{DynamicResource Grip.Accent}" Margin="0,0,8,0" />
                <TextBlock Text="{l:T scratchpad.title}" Style="{StaticResource Grip.Text.Strong}" VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource Grip.Divider}" />

            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="10,6,10,0">
                <StackPanel x:Name="Tabs" Orientation="Horizontal" />
            </ScrollViewer>

            <TextBlock DockPanel.Dock="Bottom" Text="{l:T scratchpad.autosave}" Style="{StaticResource Grip.Text.Caption}"
                       HorizontalAlignment="Center" Margin="10,4,10,10" />

            <Grid Margin="14,4,10,4">
                <TextBox x:Name="Editor" Padding="0,0,4,0" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource Grip.Text}" CaretBrush="{DynamicResource Grip.Accent}" SelectionBrush="{DynamicResource Grip.Selection}"
                         FontFamily="{StaticResource Grip.Font}" FontSize="13.5" FocusVisualStyle="{x:Null}"
                         TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                         TextChanged="OnTextChanged" />
                <FlowDocumentScrollViewer x:Name="Preview" Padding="0,0,4,0" VerticalScrollBarVisibility="Auto"
                                          IsToolBarVisible="False" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
