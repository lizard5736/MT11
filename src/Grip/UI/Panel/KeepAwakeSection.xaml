<local:PanelSection x:Class="Grip.UI.Panel.KeepAwakeSection"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Grip.UI.Panel"
                    xmlns:c="clr-namespace:Grip.UI.Controls"
                    xmlns:l="clr-namespace:Grip.UI">
    <Border Style="{StaticResource Grip.Card}" Padding="{DynamicResource Grip.Space.Card}">
        <StackPanel>
            <DockPanel>
                <ToggleButton x:Name="Switch" DockPanel.Dock="Right" Style="{StaticResource Grip.Toggle}" Click="OnSwitch" />
                <Border x:Name="Badge" Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Grip.Control}">
                    <c:Icon x:Name="BadgeIcon" Kind="WeatherMoon" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="{DynamicResource Grip.TextSecondary}" />
                </Border>
                <StackPanel Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:T keepAwake.title}" Style="{StaticResource Grip.Text.Strong}" />
                    <TextBlock x:Name="Status" Style="{StaticResource Grip.Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource Grip.Divider}" Margin="0,14,0,12" />

            <WrapPanel x:Name="Presets" />
            <DockPanel x:Name="UntilRow" Visibility="Collapsed" Margin="0,4,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource Grip.Button.Accent}" Content="{l:T common.apply}" Margin="8,0,0,0"
                        Padding="14,6" Click="OnApplyUntil" />
                <TextBlock Text="{l:T keepAwake.until.title}" Style="{StaticResource Grip.Text.Secondary}" VerticalAlignment="Center" Margin="2,0,10,0"
                           DockPanel.Dock="Left" />
                <TextBox x:Name="UntilBox" Style="{StaticResource Grip.TextBox}" l:TextBoxHelper.Placeholder="18:30" MaxLength="5"
                         KeyDown="OnUntilKey" />
            </DockPanel>

            <Border Style="{StaticResource Grip.Divider}" Margin="0,8,0,12" />

            <DockPanel>
                <ToggleButton x:Name="DisplaySwitch" DockPanel.Dock="Right" Style="{StaticResource Grip.Toggle}" Click="OnDisplay" />
                <StackPanel VerticalAlignment="Center" Margin="2,0,12,0">
                    <TextBlock Text="{l:T keepAwake.display}" Style="{StaticResource Grip.Text.Body}" />
                    <TextBlock Text="{l:T keepAwake.display.desc}" Style="{StaticResource Grip.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <DockPanel x:Name="LidRow" Margin="0,12,0,0">
                <ToggleButton x:Name="LidSwitch" DockPanel.Dock="Right" Style="{StaticResource Grip.Toggle}" Click="OnLid" />
                <StackPanel VerticalAlignment="Center" Margin="2,0,12,0">
                    <TextBlock Text="{l:T keepAwake.lid}" Style="{StaticResource Grip.Text.Body}" />
                    <TextBlock x:Name="LidNote" Text="{l:T keepAwake.lid.desc}" Style="{StaticResource Grip.Text.Caption}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</local:PanelSection>
