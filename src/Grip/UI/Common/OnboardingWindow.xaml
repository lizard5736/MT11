<Window x:Class="Grip.UI.Common.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Grip.UI.Controls"
        xmlns:l="clr-namespace:Grip.UI"
        Style="{StaticResource Grip.Window}"
        Title="Grip" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Grip;component/Assets/grip.ico">
    <StackPanel Margin="36,30,36,28">
        <StackPanel Orientation="Horizontal">
            <c:GripMark Width="64" Height="64" TileBrush="{DynamicResource Grip.Surface}"
                        MarkBrush="{DynamicResource Grip.Accent}" DotBrush="{DynamicResource Grip.Rec}"
                        PixelImage="{DynamicResource Grip.Mark.PixelImage}" />
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:T onboarding.title}" Style="{StaticResource Grip.Text.Hero}" />
                <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Grip.Text.Secondary}" FontSize="13" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
        <TextBlock Text="{l:T onboarding.subtitle}" Style="{StaticResource Grip.Text.Body}" TextWrapping="Wrap" Margin="0,20,0,0" />

        <TextBlock Text="{l:T onboarding.presets}" Style="{StaticResource Grip.Text.Subtitle}" Margin="0,24,0,10" />
        <UniformGrid x:Name="Presets" Columns="3" Margin="-5,0,-5,0" />

        <TextBlock Text="{l:T onboarding.hotkeys}" Style="{StaticResource Grip.Text.Subtitle}" Margin="0,24,0,10" />
        <Border Style="{StaticResource Grip.Card}" Padding="16,6">
            <StackPanel x:Name="Shortcuts" />
        </Border>

        <Border Background="{DynamicResource Grip.AccentSubtle}" CornerRadius="10" Padding="14,12" Margin="0,20,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Grip.Button.Link}" Content="{l:T general.trayHint.open}" Click="OnTaskbarSettings"
                        VerticalAlignment="Center" Margin="12,0,0,0" />
                <c:Icon Kind="Info" Size="18" Foreground="{DynamicResource Grip.AccentText}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{l:T onboarding.pinHint}" Style="{StaticResource Grip.Text.Body}" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Button Style="{StaticResource Grip.Button.Accent}" Content="{l:T onboarding.start}" HorizontalAlignment="Right" MinWidth="140"
                Padding="18,9" Margin="0,24,0,0" IsDefault="True" Click="OnStart" />
    </StackPanel>
</Window>
