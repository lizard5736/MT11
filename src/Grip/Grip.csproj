<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Grip</RootNamespace>
    <AssemblyName>Grip</AssemblyName>
    <ApplicationIcon>Assets\grip.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single-file, self-contained publish: one Grip.exe that runs without installing .NET. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- WinForms is referenced only for the tray icon. WPF reads DPI awareness from app.manifest,
         so the WinForms-only ApplicationHighDpiMode suggestion does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share names such as Application and Clipboard; Grip uses WPF's. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- The GPU's display name (Win32_VideoController): no simpler safe way to read it than WMI. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <!-- Parses Markdown for the scratchpad's preview. Pure managed code, no native/COM
         surface — unlike WMI or PDH, a parsing bug here can only mis-render, never crash. -->
    <PackageReference Include="Markdig" Version="0.41.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Grip.Core\Grip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\grip.ico" />
  </ItemGroup>

</Project>
