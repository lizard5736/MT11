<Application x:Class="Grip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the palette; ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="UI/Theme/Colors.Dark.xaml" />
                <ResourceDictionary Source="UI/Theme/Icons.xaml" />
                <ResourceDictionary Source="UI/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
